# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/selah
# DATABASE_SSL=true

# Session/auth
SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_EMAIL_SHIELD=admin@example.com

# Companion LLM
GROQ_API_KEY=your-groq-api-key-here
