{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
    "dev:api": "tsx backend/server.ts",
    "start": "tsx backend/server.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "lint": "cd frontend && eslint .",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "node --import tsx --test backend/server.test.js backend/auth.test.js frontend/src/lib/bible.test.ts frontend/src/lib/verses.test.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.app.json",
    "dev:frontend": "vite --config frontend/vite.config.ts --host"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/react-router-dom": "^5.3.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.344.0",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.1.1"
  }
}
